# ---------- required ----------
# Encrypts every user's Deriv tokens and signs site sessions. Generate: python -m backend.cli genkey
# Keep it secret and backed up - if it changes, users simply log in with Deriv again.
MASTER_KEY=

# Your Deriv app id from https://api.deriv.com (Dashboard -> Register application).
# Set its Redirect URL to your site's address, e.g. https://trade.yourdomain.com/
DERIV_APP_ID=1089

# ---------- your brand (shown on the site; never use Deriv's name or logo as your brand) ----------
BRAND_NAME=Your Brand
BRAND_TAGLINE=Automated trading for Deriv accounts
SUPPORT_EMAIL=

# ---------- users ----------
# Emails (as registered on Deriv) that get the Admin page. If empty, the FIRST person to sign in becomes admin,
# so sign in yourself before sharing the link.
ADMIN_EMAILS=
OPEN_REGISTRATION=true
MAX_USERS=200
SESSION_HOURS=72

# Optional: your Deriv affiliate token, appended to the "Create a free Deriv account" link
DERIV_AFFILIATE_TOKEN=

# ---------- infrastructure ----------
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_OAUTH_URL=https://oauth.deriv.com/oauth2/authorize
# POSTGRES_PASSWORD=    (generate a long random one)
# DATABASE_URL=postgresql+psycopg://trader:<POSTGRES_PASSWORD>@db:5432/terminal   (recommended for many users)
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
